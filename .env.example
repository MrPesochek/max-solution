# Локальный стенд: docker compose --env-file .env.example up --build
COMPOSE_FILE=compose.yaml:compose.demo.yaml

APP_ENV=local

DEMO_LOGIN_ENABLED=true
DEMO_LOGIN_WITH_REAL_BOT=false

POSTGRES_PASSWORD=repair

PUBLIC_BASE_URL=http://localhost:8080

MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=
MAX_UPDATES_MODE=off

MAX_WEBAPP_MODE=mini_app

AUTH_RATE_LIMIT_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

MAX_UPLOAD_BYTES=10485760
MAX_REQUEST_BODY=11MiB

SECRETS_ENCRYPTION_KEY=

ALLOWED_PRIVATE_WEBHOOK_HOSTS=

CONNECTOR_API_KEY=
CONNECTOR_POLL_INTERVAL_SECONDS=5

ONEC_ODATA_PASSWORD=odata-demo
ONEC_UI_PASSWORD=demo
ONEC_SESSION_SECRET=change-me-session-secret
ONEC_ALLOW_DEFAULTS=true

WEB_BIND=127.0.0.1
WEB_PORT=8080
ONEC_EMULATOR_BIND=127.0.0.1
ONEC_EMULATOR_PORT=8082
CONNECTOR_BIND=127.0.0.1
CONNECTOR_PORT=8083
API_DEBUG_BIND=127.0.0.1
API_DEBUG_PORT=8000

COMPOSE_SUBNET=172.30.57.0/24
WEB_PROXY_IP=172.30.57.10

WEBAPP_DEMO_LOGIN=true
MAX_BRIDGE_URL=https://st.max.ru/js/max-web-app.js

SITE_ADDRESS=:8080
