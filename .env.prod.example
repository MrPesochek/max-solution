# Переменные боевого стенда на сервере с доменом (docs/deploy.md). На сервере:
#   cp .env.prod.example .env && chmod 600 .env
# заполнить значения ниже и выложить: bash scripts/deploy.sh
# .env содержит все секреты стенда: не коммитить, не пересылать, копию ключа
# SECRETS_ENCRYPTION_KEY хранить отдельно от резервных копий БД.
# Пустые обязательные значения compose не пропустит (сообщение назовёт переменную).

# Базовый стенд + боевой слой. compose.demo.yaml (demo-данные, эмулятор 1С) не подключать.
COMPOSE_FILE=compose.yaml:compose.prod.yaml
# Коннектор 1С к базе клиента: COMPOSE_PROFILES=onec (раздел «Коннектор 1С» ниже).
COMPOSE_PROFILES=

# Окружение и demo-вход в compose.prod.yaml зашиты (APP_ENV=prod, demo-вход выключен);
# здесь они для наглядности и для команд, запущенных мимо compose.
APP_ENV=prod
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_WITH_REAL_BOT=false
WEBAPP_DEMO_LOGIN=false
# Демонстрационные организации для жюри после входа через MAX (данные общие).
DEMO_SHOWCASE_ENABLED=false

# Публичный адрес стенда, только https. Из него же Caddy берёт домен сертификата,
# бот — ссылки на Web App, а api — адрес вебхука MAX (PUBLIC_BASE_URL/max/webhook).
PUBLIC_BASE_URL=https://repair.example.ru
# Адрес для уведомлений Let's Encrypt (необязательно).
ACME_EMAIL=

# Пароль пользователя repair в PostgreSQL. Только [0-9a-f] — он подставляется в URL
# подключения. Действует при первом создании тома pgdata; смена — docs/deploy.md.
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Бот MAX этого окружения (свой на каждое окружение).
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
# Секрет подписи вебхука MAX (заголовок X-Max-Bot-Api-Secret). Обязателен при
# MAX_UPDATES_MODE=webhook. Подписку на PUBLIC_BASE_URL/max/webhook api создаёт сам
# при старте, worker проверяет её каждые 15 минут.
#   openssl rand -hex 32
MAX_WEBHOOK_SECRET=
# Прежнее значение MAX_WEBHOOK_SECRET — только на время ротации: api принимает его,
# пока подписка не переведена на новый секрет (docs/deploy.md, «Ротация секретов»).
MAX_WEBHOOK_SECRET_PREVIOUS=
# Токен внешней проверки /ops/status и /ops/metrics (docs/monitoring.md). Пусто —
# доступ только из внутренней сети, через docker compose exec api.
#   openssl rand -hex 32
OPS_TOKEN=
# webhook — MAX присылает события на домен (по умолчанию); polling — сервер сам
# опрашивает MAX. На один токен — только один из режимов.
MAX_UPDATES_MODE=webhook
# mini_app — кнопка мини-приложения (адрес Web App = PUBLIC_BASE_URL зарегистрирован
# в настройках бота в MAX); link — одноразовая ссылка входа, если доступа к ним нет.
MAX_WEBAPP_MODE=mini_app

# Bridge мини-приложений MAX: его адрес попадает в сборку Web App и в CSP (script-src).
MAX_BRIDGE_URL=https://st.max.ru/js/max-web-app.js
# Кто может встраивать Web App во фрейм (веб-версия MAX).
MAX_FRAME_ANCESTORS=https://*.max.ru

# Fernet-ключ шифрования секретов подписок на вебхуки. Задаётся только здесь и
# хранится в двух местах: в этом .env и в менеджере паролей (без него бэкап БД
# бесполезен для подписей вебхуков). Ротация — несколько ключей через запятую,
# шифрует первый (docs/deploy.md, «Ротация секретов»).
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   или без Python на сервере: openssl rand -base64 32 | tr '+/' '-_'
SECRETS_ENCRYPTION_KEY=

# Лимит попыток входа с одного IP за окно (в памяти процесса api).
AUTH_RATE_LIMIT_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Размер загружаемого файла и тот же потолок тела запроса на Caddy (с запасом на multipart).
MAX_UPLOAD_BYTES=10485760
MAX_REQUEST_BODY=11MiB

# HSTS. includeSubDomains — только если все поддомены домена работают по https.
HSTS=max-age=31536000
# Балансировщик или CDN перед сервером (CIDR через пробел): только им Caddy верит
# X-Forwarded-For. Без прокси перед сервером оставить как есть.
TRUSTED_PROXIES=127.0.0.1/32

# Образы: имя и тег. IMAGE_TAG пишет scripts/deploy.sh (текущая выкладка), руками не
# менять. IMAGE_PREFIX — свой реестр, если образы собирает CI (deploy.sh --pull TAG).
IMAGE_PREFIX=repair-hub
IMAGE_TAG=

# Сеть compose и адрес Caddy, от которого api принимает X-Forwarded-For. Менять,
# только если подсеть занята на сервере.
COMPOSE_SUBNET=172.30.57.0/24
WEB_PROXY_IP=172.30.57.10

# Резервные копии (scripts/backup.sh): каталог и срок хранения, дней. Секреты (.env)
# складываются в BACKUP_DIR/secrets с правами 0700 — копируйте их в другое место,
# чем дампы БД.
BACKUP_DIR=/var/backups/repair-hub
BACKUP_KEEP_DAYS=14

# --- Коннектор 1С (только при COMPOSE_PROFILES=onec) ---
# Ключ интеграционного API сервисной компании: Web App -> Интеграция -> ключи
# (роль provider_admin). Формат rk_prod_<prefix>_<secret>.
ONEC_PLATFORM_API_KEY=
# Публикация OData базы 1С клиента, только https.
ONEC_ODATA_URL=https://1c.example.ru/unf/odata/standard.odata
ONEC_USERNAME=
ONEC_PASSWORD=
# true | false | /app/custom/<ca>.pem (файл в deploy/onec/) для самоподписанного сертификата 1С
ONEC_VERIFY_TLS=true
# unf | generic | /app/custom/<профиль>.yaml (файл в deploy/onec/)
ONEC_PROFILE=unf
ONEC_POLL_INTERVAL_SECONDS=15

# Демонстрационная CRM из проекта: дополнительно compose.crm.yaml и внешний
# HTTPS reverse proxy в Docker-сети routing. Это эмулятор, не лицензированная 1С.
# Для неё ONEC_ODATA_URL=https://1c.baseclub.lol/unf_demo/odata/standard.odata,
# ONEC_USERNAME=odata, ONEC_PASSWORD — отдельный случайный пароль OData.
ONEC_UI_PASSWORD=
ONEC_SESSION_SECRET=
